# Reference Caddyfile for putting certguard behind Caddy. Add a block like this
# to your own Caddy (e.g. a proxy you already run for several apps), setting the
# hostname to whatever resolves to your host. For a self-contained bundled-Caddy
# stack instead, use docker-compose.internal.yml (LAN) or docker-compose.aio.yml
# (public domain) — you don't need this file for those.
#
# Public domain: Let's Encrypt — needs ports 80+443 reachable and the domain's
# DNS pointing here.
{$CERTGUARD_DOMAIN} {
	encode zstd gzip
	reverse_proxy certguard:8181
}

# Internal-only domain (not resolvable by Let's Encrypt)? Replace the block above
# with the following to use Caddy's own local CA instead (install its root once):
#
# {$CERTGUARD_DOMAIN} {
# 	tls internal
# 	reverse_proxy certguard:8181
# }
